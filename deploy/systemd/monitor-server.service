[Unit]
Description=Monitor Server
After=network-online.target
Wants=network-online.target

[Service]
User=monitor
Group=monitor
EnvironmentFile=/etc/monitor/server.env
ExecStart=/usr/local/bin/monitor -mode server -listen 127.0.0.1:8090
Restart=on-failure
RestartSec=5
StateDirectory=monitor
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
